{
  "hasCompletedOnboarding": true,
  "bypassPermissionsModeAccepted": true,
  "projects": {
    "/home/agent": {
      "hasTrustDialogAccepted": true,
      "hasCompletedProjectOnboarding": true,
      "allowedTools": []
    }
  },
  "mcpServers": {
    "desktop": {
      "command": "/usr/local/bin/uv",
      "args": ["run", "--script", "/opt/agent-tools/computer_use.py"],
      "env": { "DISPLAY": ":1" }
    },
    "discord": {
      "command": "node",
      "args": ["/opt/agent-tools/discord-mcp/dist/index.js"],
      "env": { "DISPLAY": ":1" }
    },
    "swarm": {
      "command": "/usr/local/bin/uv",
      "args": ["run", "--script", "/opt/agent-tools/swarm.py"],
      "env": { "SWARM_GATEWAY": "http://dashboard:8080" }
    }
  }
}
