# Copy to .env and fill in. Everything here is optional — you can also configure
# the token from the dashboard Settings page after the stack is up.

# --- Claude authentication ---
# Claude Code OAuth token. Generate on any machine with Claude Code:
#   claude setup-token        # prints an sk-ant-oat… value
# Injected into every agent as CLAUDE_CODE_OAUTH_TOKEN so sessions bill to your
# subscription. Leave blank to set it later in the dashboard (Settings page).
CLAUDE_CODE_OAUTH_TOKEN=

# --- Control plane ---
# The single published port for the whole fleet (dashboard + all agents proxied
# under /a/:id). Change if 8080 is taken.
PORT=8080

# Docker engine socket the gateway drives to spawn/stop/remove agents.
DOCKER_SOCKET=/var/run/docker.sock
