# Copy to .env and fill in. Everything here is optional — you can also configure
# the token from the dashboard Settings page after the stack is up.

# --- Claude authentication ---
# Claude Code OAuth token. Generate on any machine with Claude Code:
#   claude setup-token        # prints an sk-ant-oat… value
# Injected into every agent as CLAUDE_CODE_OAUTH_TOKEN so sessions bill to your
# subscription. Leave blank to set it later in the dashboard (Settings page).
CLAUDE_CODE_OAUTH_TOKEN=

# --- Control plane ---
# Host port the dashboard is published on (compose maps it to :8080 inside the
# container). Change if 8080 is already taken on the host.
DASHBOARD_PORT=8080

# Port the gateway listens on *inside* the container. Rarely needs changing.
PORT=8080

# Docker engine socket the gateway drives to spawn/stop/remove agents.
DOCKER_SOCKET=/var/run/docker.sock

# --- Agent graphics ---
# Set to 1 on a host with a GPU to pass /dev/dri into agents for hardware-
# accelerated browser graphics (AMD/Intel via Mesa). Agents fall back to software
# rendering if the device is absent, so leave blank on machines without a GPU.
AGENT_GPU=
# Shared-memory size for agent containers, MB (Chrome needs more than the 64MB
# Docker default or its compositor crashes).
AGENT_SHM_MB=512
