# --- Anthropic / Claude ---
# Optional fallback. Agents primarily reuse the host's Claude login via the
# mounted credentials file below (see README → Authentication).
ANTHROPIC_API_KEY=

# Path to the shared Claude credentials file bind-mounted into each agent.
# On macOS this is bridged from the Keychain by the control plane at boot.
CLAUDE_CREDENTIALS_FILE=~/.agent-swarm/.credentials.json

# --- Persistence ---
DATABASE_URL=postgres://swarm:swarm@localhost:5432/agent_swarm

# --- Control plane ---
PORT=8080

# Docker engine socket the control plane drives.
DOCKER_SOCKET=/var/run/docker.sock
