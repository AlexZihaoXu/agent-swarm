# Copy to .env and fill in. Everything here is optional — you can also configure
# the token from the dashboard Settings page after the stack is up.

# --- Claude authentication ---
# Claude Code OAuth token. Generate on any machine with Claude Code:
#   claude setup-token        # prints an sk-ant-oat… value
# Injected into every agent as CLAUDE_CODE_OAUTH_TOKEN so sessions bill to your
# subscription. Leave blank to set it later in the dashboard (Settings page).
CLAUDE_CODE_OAUTH_TOKEN=

# --- Control plane ---
# Host port the dashboard is published on (compose maps it to :8080 inside the
# container). Change if 8080 is already taken on the host.
DASHBOARD_PORT=8080

# Port the gateway listens on *inside* the container. Rarely needs changing.
PORT=8080

# Docker engine socket the gateway drives to spawn/stop/remove agents.
DOCKER_SOCKET=/var/run/docker.sock

# Trust X-Forwarded-For / X-Forwarded-Proto headers. Enable ONLY when the gateway
# sits behind a reverse proxy you control that sets them (then the client IP for
# login rate-limiting and the HTTPS detection for the Secure cookie come from the
# proxy). Leave OFF (default) when clients reach the gateway directly — these
# headers are forgeable, so trusting them would let an attacker spoof their IP
# past the rate-limiter or break login by forcing a Secure cookie over HTTP.
TRUST_PROXY=

# --- Agent graphics ---
# Set to 1 on a host with a GPU to pass /dev/dri into agents for hardware-
# accelerated browser graphics (AMD/Intel via Mesa). Agents fall back to software
# rendering if the device is absent, so leave blank on machines without a GPU.
AGENT_GPU=
# Shared-memory size for agent containers, MB (Chrome needs more than the 64MB
# Docker default or its compositor crashes).
AGENT_SHM_MB=512

# --- Agent isolation (strongly recommended on Linux) ---
# Container runtime for agents. On a Linux host, install Sysbox
# (https://github.com/nestybox/sysbox) and set this to `sysbox-runc` to run each
# agent's systemd/GNOME desktop UNPRIVILEGED inside a user namespace: container
# root maps to an unprivileged host uid, so the gateway can drop SYS_ADMIN, the
# unconfined seccomp/apparmor profiles, and cgroupns=host. This is the strongest
# agent↔host isolation. Leave blank for the default `runc` (required on macOS /
# Docker Desktop, where Sysbox isn't available — there the privileged flags are
# kept so systemd/GNOME can boot). Note: GPU passthrough (AGENT_GPU) is best left
# off under sysbox; agents fall back to software rendering.
AGENT_RUNTIME=
