{
  "name": "agent-swarm",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@9.12.2",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "pnpm -r --if-present build",
    "typecheck": "pnpm -r --if-present typecheck",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write apps docs images scripts \"*.{json,md,js,ts,yml,yaml}\"",
    "format:check": "prettier --check apps docs images scripts \"*.{json,md,js,ts,yml,yaml}\"",
    "prepare": "lefthook install"
  },
  "devDependencies": {
    "@commitlint/cli": "^19.8.1",
    "@commitlint/config-conventional": "^19.8.1",
    "@eslint/js": "^9.39.5",
    "eslint": "^9.39.5",
    "eslint-config-prettier": "^9.1.2",
    "lefthook": "^1.13.6",
    "prettier": "~3.8.3",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.73.0"
  }
}
